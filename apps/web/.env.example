# Laravel API as reached from the Next.js server
API_INTERNAL_URL=http://127.0.0.1:8000
# Public origin of the API (tender downloads, images)
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
# Shared secret for on-demand revalidation (must match WEB_REVALIDATE_SECRET in the API)
REVALIDATE_SECRET=change-me-dev-revalidate-secret
